#!/usr/bin/env python3
import json
import os
import subprocess
import sys

ALLOWLIST = {{ALLOWLIST}}


def main():
    if sys.version_info < (3, 8):
        print("cairn pre-push hook requires Python 3.8+", file=sys.stderr)
        sys.exit(1)

    env_override = os.environ.get("CAIRN_ALLOWED_REMOTE_PREFIXES")
    if env_override:
        allowlist = [p.strip() for p in env_override.split(",") if p.strip()]
    else:
        allowlist = ALLOWLIST

    remote_name = sys.argv[1] if len(sys.argv) > 1 else ""
    remote_url = sys.argv[2] if len(sys.argv) > 2 else ""

    if remote_name and not remote_url.startswith(("http", "git@", "ssh://")):
        try:
            result = subprocess.run(
                ["git", "remote", "get-url", remote_name],
                capture_output=True,
                text=True,
            )
        except OSError as exc:
            print(f"cairn: could not run git to resolve remote '{remote_name}': {exc}",
                  file=sys.stderr)
            sys.exit(1)
        if result.returncode != 0:
            detail = result.stderr.strip() or f"git exited {result.returncode}"
            print(
                f"cairn: could not resolve the URL of remote '{remote_name}', "
                f"so it cannot be checked against the allowlist: {detail}",
                file=sys.stderr,
            )
            sys.exit(1)
        remote_url = result.stdout.strip()

    if not remote_url:
        print(
            "cairn: no remote URL was supplied to the pre-push hook, "
            "so it cannot be checked against the allowlist",
            file=sys.stderr,
        )
        sys.exit(1)

    allowed = any(remote_url.startswith(prefix) for prefix in allowlist)
    if not allowed:
        print(
            f"cairn: remote URL not in allowlist: {remote_url}",
            file=sys.stderr,
        )
        sys.exit(1)

    sys.exit(0)


if __name__ == "__main__":
    main()
