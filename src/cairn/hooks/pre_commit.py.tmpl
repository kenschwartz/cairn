ASSET_SIZE_CAP = 1024 * 1024


def get_staged_files():
    result = subprocess.run(
        ["git", "diff", "--cached", "--name-only", "-z"],
        capture_output=True,
        text=True,
        check=True,
    )
    if not result.stdout:
        return []
    return result.stdout.rstrip("\0").split("\0")


def get_staged_deletions():
    result = subprocess.run(
        ["git", "diff", "--cached", "--name-only", "--diff-filter=D", "-z"],
        capture_output=True,
        text=True,
        check=True,
    )
    if not result.stdout:
        return set()
    return set(result.stdout.rstrip("\0").split("\0"))


def get_staged_content(path):
    result = subprocess.run(
        ["git", "show", f":{path}"],
        capture_output=True,
        check=True,
    )
    return result.stdout


def main():
    if sys.version_info < (3, 8):
        print("cairn pre-commit hook requires Python 3.8+", file=sys.stderr)
        sys.exit(1)

    staged = get_staged_files()
    deletions = get_staged_deletions()
    findings = []

    for path in staged:
        if path.startswith(".git/"):
            continue
        if path in deletions:
            continue
        content = get_staged_content(path)
        findings.extend(scan_bytes(content, path))

        if path.startswith("assets/") and not path.startswith("assets/local/"):
            size = len(content)
            if size > ASSET_SIZE_CAP:
                print(
                    f"cairn: asset {path} exceeds size cap ({size} > {ASSET_SIZE_CAP})",
                    file=sys.stderr,
                )
                sys.exit(1)

    manifest_path = "assets/local.manifest.json"
    manifest_source = None
    if manifest_path in staged:
        try:
            manifest_source = get_staged_content(manifest_path).decode("utf-8", errors="replace")
        except Exception:
            pass
    elif os.path.exists(manifest_path):
        try:
            with open(manifest_path, "r", encoding="utf-8") as f:
                manifest_source = f.read()
        except Exception:
            pass

    if manifest_source is not None:
        try:
            manifest = json.loads(manifest_source)
        except json.JSONDecodeError:
            manifest = None

        if manifest is not None:
            for entry in manifest.get("entries", []):
                p = entry.get("path", "")
                expected_sha = entry.get("sha256", "")
                if not p or not expected_sha:
                    continue
                if not os.path.exists(p):
                    print(
                        f"cairn: warning: manifest entry {p} missing on disk",
                        file=sys.stderr,
                    )
                    continue
                try:
                    with open(p, "rb") as f:
                        import hashlib
                        actual_sha = hashlib.sha256(f.read()).hexdigest()
                except OSError:
                    print(
                        f"cairn: manifest read failed for {p}",
                        file=sys.stderr,
                    )
                    sys.exit(1)
                if actual_sha != expected_sha:
                    print(
                        f"cairn: manifest SHA-256 mismatch for {p}",
                        file=sys.stderr,
                    )
                    sys.exit(1)

    if findings:
        for f in findings:
            print(f"{f.rule}: {f.path}:{f.line} {f.excerpt}", file=sys.stderr)
        sys.exit(1)

    sys.exit(0)


if __name__ == "__main__":
    main()
