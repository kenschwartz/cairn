ASSET_SIZE_CAP = 1024 * 1024


def fail(message):
    """Block the commit with a clear message. The scan fails closed: a check
    that could not run is never reported as a check that passed."""
    print(f"cairn: {message}", file=sys.stderr)
    sys.exit(1)


def run_git(args):
    try:
        return subprocess.run(["git"] + args, capture_output=True)
    except OSError as exc:
        fail(f"could not run git {' '.join(args)}: {exc}")


def get_staged_files():
    # --diff-filter=d excludes deletions: there is no staged content to scan
    # for a removed path, and asking git for it would fail the commit.
    result = run_git(["diff", "--cached", "--name-only", "--diff-filter=d", "-z"])
    if result.returncode != 0:
        fail(
            "could not list staged files: "
            + (result.stderr.decode("utf-8", "replace").strip() or f"git exited {result.returncode}")
        )
    if not result.stdout:
        return []
    return result.stdout.decode("utf-8", "surrogateescape").rstrip("\0").split("\0")


def get_staged_content(path):
    result = run_git(["show", f":{path}"])
    if result.returncode != 0:
        fail(
            f"could not read staged content for {path}: "
            + (result.stderr.decode("utf-8", "replace").strip() or f"git exited {result.returncode}")
        )
    return result.stdout


def main():
    if sys.version_info < (3, 8):
        print("cairn pre-commit hook requires Python 3.8+", file=sys.stderr)
        sys.exit(1)

    staged = get_staged_files()
    findings = []

    for path in staged:
        if path.startswith(".git/"):
            continue
        content = get_staged_content(path)
        if b"\x00" in content[:8192]:
            continue
        findings.extend(scan_bytes(content, path))

        if path.startswith("assets/") and not path.startswith("assets/local/"):
            size = len(content)
            if size > ASSET_SIZE_CAP:
                print(
                    f"cairn: asset {path} exceeds size cap ({size} > {ASSET_SIZE_CAP})",
                    file=sys.stderr,
                )
                sys.exit(1)

    manifest_path = "assets/local.manifest.json"
    manifest_source = None
    if manifest_path in staged:
        manifest_source = get_staged_content(manifest_path).decode("utf-8", errors="replace")
    elif os.path.exists(manifest_path):
        try:
            with open(manifest_path, "r", encoding="utf-8") as f:
                manifest_source = f.read()
        except OSError as exc:
            fail(f"could not read {manifest_path}, so its entries cannot be verified: {exc}")

    if manifest_source is not None:
        try:
            manifest = json.loads(manifest_source)
        except json.JSONDecodeError as exc:
            fail(f"{manifest_path} is not valid JSON, so its entries cannot be verified: {exc}")
        if not isinstance(manifest, dict):
            fail(f"{manifest_path} must contain a JSON object")

        entries = manifest.get("entries", [])
        if not isinstance(entries, list):
            fail(f"{manifest_path} 'entries' must be a JSON array")

        for entry in entries:
            if not isinstance(entry, dict):
                fail(f"{manifest_path} has a non-object entry: {entry!r}")
            p = entry.get("path", "")
            expected_sha = entry.get("sha256", "")
            if not p or not expected_sha:
                fail(f"{manifest_path} has an entry missing 'path' or 'sha256': {entry!r}")
            if not os.path.exists(p):
                # A missing local file is expected on a fresh clone: warn, do not block.
                print(
                    f"cairn: warning: manifest entry {p} missing on disk",
                    file=sys.stderr,
                )
                continue
            try:
                with open(p, "rb") as f:
                    actual_sha = hashlib.sha256(f.read()).hexdigest()
            except OSError as exc:
                fail(f"could not read {p} to verify its manifest hash: {exc}")
            if actual_sha != expected_sha:
                fail(f"manifest SHA-256 mismatch for {p}")

    if findings:
        for f in findings:
            print(f"{f.rule}: {f.path}:{f.line} {f.excerpt}", file=sys.stderr)
        sys.exit(1)

    sys.exit(0)


if __name__ == "__main__":
    main()
